# Copy to .env for local runs. Never commit your real .env.
# On GitHub, add these as repository secrets instead (Settings > Secrets and variables > Actions).

# Stage 3: email alerts
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
ALERT_TO=you@gmail.com

# Stage 5: paper trading
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER_TRADE=true
